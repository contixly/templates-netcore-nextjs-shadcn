    "/api/v1/system/status": {
      "get": {
        "tags": [
          "Template.Api"
        ],
        "summary": "Returns API status and echoes a validated optional value.",
        "operationId": "GetSystemStatus",
        "parameters": [
          {
            "name": "echo",
            "in": "query",
            "schema": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseOfSystemStatusResponse"
